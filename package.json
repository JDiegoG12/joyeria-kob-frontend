    "husky": "^9.1.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.1",
    "vitest": "^4.1.8"
