# ─── SPA fallback ──────────────────────────────────────────────────────
# Sin esto, /catalogo, /admin/joyas, etc. dan 404 porque Apache busca un
# archivo físico que no existe. Reescribimos a /index.html y dejamos que
# React Router decida la vista en el cliente.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ─── Canonicalización de host + protocolo (301) ─────
  # Unifica todas las variantes de dominio hacia el canónico único:
  #   http://joyeriakob.com/x, https://joyeriakob.com/x, http://www...   →
  #   https://www.joyeriakob.com/x   (un ÚNICO salto 301)
  #
  # Por qué va aquí y no después: debe ejecutarse ANTES del dynamic rendering
  # [R=302] y del fallback SPA, para que Google nunca vea una cadena
  # 302→301 ni indexe duplicados no-www / http. Sin esta regla, joyeriakob.com
  # y www.joyeriakob.com servían contenido idéntico (200), y GSC los reportaba
  # como "Página alternativa con etiqueta canónica adecuada".
  #
  # La condición combina host y protocolo con [OR]: se dispara si el host NO es
  # exactamente www.joyeriakob.com O si la conexión NO es HTTPS. En ambos casos
  # el destino es el mismo (https://www...), así que se resuelve en UN solo 301.
  #
  # %{REQUEST_URI} preserva la ruta; mod_rewrite reañade el query string
  # original automáticamente (el destino no lleva '?'), así que /x?y=z se
  # conserva íntegro. [NE] evita que se re-escapen caracteres ya codificados.
  RewriteCond %{HTTP_HOST} !^www\.joyeriakob\.com$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.joyeriakob.com%{REQUEST_URI} [R=301,L,NE]

  # ─── Dynamic rendering para bots (SEO) — ANTES del fallback SPA ────────
  # Si un crawler (Googlebot, Bingbot, redes sociales, etc.) pide una página
  # pública, se redirige (302) al backend, que devuelve HTML pre-renderizado
  # con el contenido real (title, meta, og:*, texto). Para usuarios normales
  # (User-Agent que NO matchea) estas reglas se saltan y la petición cae en
  # el fallback SPA de más abajo, sirviendo index.html como siempre.
  #
  # IMPORTANTE: cada RewriteCond aplica SOLO a la RewriteRule inmediatamente
  # siguiente. Por eso la condición de User-Agent se REPITE antes de cada
  # regla; si se pusiera una sola vez, /catalogo y /producto redirigirían a
  # TODOS los visitantes, no solo a los bots.
  #
  # El flag [L] corta el procesamiento al primer match, así un bot nunca llega
  # al fallback SPA. La parte de nombre del slug de /producto/<slug> se pasa
  # íntegra al backend en $1 (el backend extrae el UUID del final).
  RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandex|facebookexternalhit|facebot|twitterbot|whatsapp|linkedinbot|telegrambot|discordbot|applebot|pinterest|redditbot) [NC]
  RewriteRule ^$ https://api.joyeriakob.com/render/home [R=302,L]

  RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandex|facebookexternalhit|facebot|twitterbot|whatsapp|linkedinbot|telegrambot|discordbot|applebot|pinterest|redditbot) [NC]
  RewriteRule ^catalogo/?$ https://api.joyeriakob.com/render/catalogo [R=302,L]

  RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandex|facebookexternalhit|facebot|twitterbot|whatsapp|linkedinbot|telegrambot|discordbot|applebot|pinterest|redditbot) [NC]
  RewriteRule ^producto/([^/]+)/?$ https://api.joyeriakob.com/render/producto/$1 [R=302,L]

  # Si la URL pide un archivo real (ej. /assets/index-abc.js, /favicon.svg),
  # se sirve tal cual. Esta condición es CRÍTICA — sin ella reescribirías
  # incluso las peticiones a tus assets y la página queda en blanco.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Todo lo demás → index.html
  RewriteRule . /index.html [L]
</IfModule>

# ─── Caché de assets con hash ──────────────────────────────────────────
# Vite genera nombres con hash de contenido (ej. index-Bx9aQ12.js). Si el
# contenido cambia, el hash cambia → el navegador descarga el nuevo. Por
# eso podemos cachearlos un año sin riesgo de servir versión vieja.
<IfModule mod_expires.c>
  ExpiresActive On

  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|webp|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # index.html NO se cachea — siempre tiene que llegar fresco para que los
  # hashes de los assets que referencia sean los del último deploy.
  <FilesMatch "index\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ─── Compresión gzip ───────────────────────────────────────────────────
# Reduce el tamaño de transferencia de JS/CSS/HTML ~70%. Hostinger soporta
# mod_deflate por defecto.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
