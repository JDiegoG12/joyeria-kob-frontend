# ─── SPA fallback ──────────────────────────────────────────────────────
# Sin esto, /catalogo, /admin/joyas, etc. dan 404 porque Apache busca un
# archivo físico que no existe. Reescribimos a /index.html y dejamos que
# React Router decida la vista en el cliente.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ─── Canonicalización de host + protocolo (301) ─────
  # Unifica todas las variantes de dominio hacia el canónico único:
  #   http://joyeriakob.com/x, https://joyeriakob.com/x, http://www...   →
  #   https://www.joyeriakob.com/x   (un ÚNICO salto 301)
  #
  # Por qué va aquí y no después: debe ejecutarse ANTES del dynamic rendering
  # [R=302] y del fallback SPA, para que Google nunca vea una cadena
  # 302→301 ni indexe duplicados no-www / http. Sin esta regla, joyeriakob.com
  # y www.joyeriakob.com servían contenido idéntico (200), y GSC los reportaba
  # como "Página alternativa con etiqueta canónica adecuada".
  #
  # La condición combina host y protocolo con [OR]: se dispara si el host NO es
  # exactamente www.joyeriakob.com O si la conexión NO es HTTPS. En ambos casos
  # el destino es el mismo (https://www...), así que se resuelve en UN solo 301.
  #
  # %{REQUEST_URI} preserva la ruta; mod_rewrite reañade el query string
  # original automáticamente (el destino no lleva '?'), así que /x?y=z se
  # conserva íntegro. [NE] evita que se re-escapen caracteres ya codificados.
  RewriteCond %{HTTP_HOST} !^www\.joyeriakob\.com$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.joyeriakob.com%{REQUEST_URI} [R=301,L,NE]

  # ─── Pre-render estático (SEO) — tras el 301, antes del fallback SPA ───
  # El backend (cron) genera por su cuenta un HTML por ruta pública en
  # /prerender/*.html DENTRO de este mismo public_html (filesystem compartido),
  # con el contenido real (title, meta, og:*, canonical, JSON-LD) y los <script>
  # de Vite intactos. Aquí lo servimos en la MISMA URL con 200, para usuarios y
  # bots por igual — React reemplaza #root al montar. Esto SUSTITUYE al antiguo
  # 302 cross-domain a api.joyeriakob.com/render/* que GSC marcaba como
  # "Página/Error de redirección".
  #
  # El RewriteCond ...-f sirve el estático SOLO si existe. Si un producto se
  # publicó DESPUÉS de la última corrida del cron, su .html aún no existe y la
  # petición cae al fallback SPA (index.html) — sigue navegable e indexable por
  # el render JS de Googlebot hasta la próxima regeneración (máx. ~6h).
  #
  # El flag [L] corta al primer match. La home también se pre-renderiza
  # (prerender/home.html); index.html se mantiene como plantilla y fallback.
  RewriteCond %{DOCUMENT_ROOT}/prerender/home.html -f
  RewriteRule ^$ /prerender/home.html [L]

  RewriteCond %{DOCUMENT_ROOT}/prerender/catalogo.html -f
  RewriteRule ^catalogo/?$ /prerender/catalogo.html [L]

  RewriteCond %{DOCUMENT_ROOT}/prerender/informacion/$1.html -f
  RewriteRule ^informacion/(terminos|garantia|privacidad|materiales)/?$ /prerender/informacion/$1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/prerender/producto/$1.html -f
  RewriteRule ^producto/([^/]+)/?$ /prerender/producto/$1.html [L]

  # Si la URL pide un archivo real (ej. /assets/index-abc.js, /favicon.svg),
  # se sirve tal cual. Esta condición es CRÍTICA — sin ella reescribirías
  # incluso las peticiones a tus assets y la página queda en blanco.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Todo lo demás → index.html
  RewriteRule . /index.html [L]
</IfModule>

# ─── Caché de assets con hash ──────────────────────────────────────────
# Vite genera nombres con hash de contenido (ej. index-Bx9aQ12.js). Si el
# contenido cambia, el hash cambia → el navegador descarga el nuevo. Por
# eso podemos cachearlos un año sin riesgo de servir versión vieja.
<IfModule mod_expires.c>
  ExpiresActive On

  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|webp|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Los .html NO se cachean — index.html (por los hashes de assets) y los
  # pre-renderizados de /prerender (su contenido cambia con el catálogo).
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ─── Compresión gzip ───────────────────────────────────────────────────
# Reduce el tamaño de transferencia de JS/CSS/HTML ~70%. Hostinger soporta
# mod_deflate por defecto.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
